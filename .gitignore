# ==============================================================================
# 1. ENVIRONMENT VARIABLES & SECRETS (CRITICAL - NEVER COMMIT TO GITHUB)
# ==============================================================================
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
*.env.*
*.env.json

# Allow only example / template environment files for onboarding
!.env.example
!.env.template
!.env.sample

# Private credentials & certificates
*.pem
*.key
*.cert
*.crt
id_rsa
id_dsa
*.pfx
*.p12

# ==============================================================================
# 2. DEPENDENCIES & PACKAGE MANAGERS
# ==============================================================================
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/

# ==============================================================================
